# ── Gemini ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="YOUR_DB_USER"
MYSQL_PASSWORD="YOUR_DB_PASSWORD"
MYSQL_DATABASE="social_listener"

# ── Reddit (PRAW) ────────────────────────────────────────────────────────────
REDDIT_CLIENT_ID="YOUR_REDDIT_CLIENT_ID"
REDDIT_CLIENT_SECRET="YOUR_REDDIT_CLIENT_SECRET"
REDDIT_USER_AGENT="social-listener/1.0"
REDDIT_SUBREDDITS="jaipur,india,btech,college"

# ── YouTube Data API v3 ──────────────────────────────────────────────────────
YOUTUBE_API_KEY="YOUR_YOUTUBE_API_KEY"

# ── NewsAPI ──────────────────────────────────────────────────────────────────
NEWS_API_KEY="YOUR_NEWSAPI_KEY"

# ── SerpAPI (discovery adapter) ──────────────────────────────────────────────
SERPAPI_KEY="YOUR_SERPAPI_KEY"
DISCOVERY_QUERIES_PER_RUN="20"

# ── Spider Cloud (web scraping) ───────────────────────────────────────────────
SPIDER_API_KEY="YOUR_SPIDER_API_KEY"
# Comma-separated seed URLs for SpiderWebAdapter
SPIDER_URLS="https://www.shiksha.com,https://www.collegedunia.com,https://www.quora.com"

# ── Tracked entities (seed for first run — managed via /keywords API after) ──
TRACKED_ENTITIES="JECRC University,JECRC"
REDDIT_KEYWORDS="JECRC University,JECRC placements,JECRC hostel"

# ── Tracked competitors (seed for first run — managed via /competitors API) ──
TRACKED_COMPETITORS="Manipal University Jaipur,Amity University Jaipur,LPU,Jaipur National University"
